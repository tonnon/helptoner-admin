# Copie para .env.local (desenvolvimento) e nunca coloque valores reais neste arquivo.

# Banco de dados usado pelo sistema (em produção, a conexão com pooler do Neon).
DATABASE_URL=
# Conexão direta (sem pooler) com o banco, usada para rodar as migrações.
DATABASE_URL_DIRETA=
# Chave secreta do Django em produção (obrigatória).
DJANGO_SECRET_KEY=
# Domínios permitidos em produção, separados por vírgula.
DJANGO_ALLOWED_HOSTS=
# Módulo de configurações: config.settings.local (padrão) ou config.settings.producao.
DJANGO_SETTINGS_MODULE=
# Caminho secreto da área administrativa do Django.
ADMIN_URL=
# Endereço do Sentry para registro de erros (opcional).
SENTRY_DSN=
# Variáveis de sistema da Vercel (a Vercel as define sozinha; não precisa preencher):
# VERCEL_ENV (production, preview ou development), VERCEL_URL, VERCEL_BRANCH_URL e
# VERCEL_PROJECT_PRODUCTION_URL. Os três últimos entram em ALLOWED_HOSTS e CSRF_TRUSTED_ORIGINS.
# VERCEL_ENV=preview faz o build migrar o banco (com DATABASE_URL_DIRETA, se houver).
# Cabeçalho com o IP real do cliente (padrão x-vercel-forwarded-for, da Vercel). No plano B (Render),
# use o cabeçalho do Render; deixe vazio para usar o endereço da conexão.
CABECALHO_IP_CLIENTE=
